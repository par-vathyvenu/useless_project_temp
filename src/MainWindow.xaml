    <Window x:Class="AnnoyingCat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ശല്യക്കാരൻ പൂച്ച (Annoying Cat)"
        Width="360" Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <!-- Row 0: Speech Bubble -->
            <RowDefinition Height="130"/>
            <!-- Row 1: Cat Sprite -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Speech Bubble Container -->
        <Grid Name="SpeechBubbleContainer" Grid.Row="0" Margin="10,5,10,0" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
            </Grid.RowDefinitions>

            <!-- Bubble Box -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E0A868" BorderThickness="2"
                    CornerRadius="14" Padding="14,10,14,10" MaxWidth="320">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Color="#4A3B32" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Name="TxtMalayalam"
                               Text="എന്താ നോക്കുന്നേ? പണിയില്ലേ?"
                               FontFamily="Segoe UI, Nirmala UI, Kartika, sans-serif"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#2C1D11"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               LineHeight="20"/>
                    <TextBlock Name="TxtEnglish"
                               Text="What are you staring at? Don't you have work?"
                               FontFamily="Segoe UI, sans-serif"
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="#7A5E4B"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Speech Bubble Tail / Triangle -->
            <Path Grid.Row="1" Data="M 0,0 L 14,0 L 7,10 Z" Fill="#FFFFFF" Stroke="#E0A868" StrokeThickness="1.5"
                  HorizontalAlignment="Center" Margin="0,-1,0,0"/>
        </Grid>

        <!-- Cat Sprite Container -->
        <Grid Name="CatContainer" Grid.Row="1"
              HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Cursor="Hand"
              MouseLeftButtonDown="Cat_MouseLeftButtonDown"
              MouseMove="Cat_MouseMove"
              MouseLeftButtonUp="Cat_MouseLeftButtonUp"
              MouseRightButtonDown="Cat_MouseRightButtonDown">

            <Image Name="CatImage"
                   Width="230" Height="250"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   RenderTransformOrigin="0.5, 1.0">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CatScale" ScaleX="1.0" ScaleY="1.0"/>
                        <TranslateTransform x:Name="CatTranslate" X="0" Y="0"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Grid>
    </Grid>
</Window>
